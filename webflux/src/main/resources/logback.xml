<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">
    <!--不输出启动日志-->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!--格式化输出：%d表示日期，%thread表示线程名，%-5level：级别从左显示5个字符宽度%msg：日志消息，%n是换行符-->
            <pattern>%blue(%d{yyyy-MM-dd HH:mm:ss.SSS}) %magenta([%thread]) [traceId-%X{traceId}]%X{apiKey}  %highlight(%-5level) %cyan(%logger{80} - [%M:%L]):%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--系统日志-->
    <appender name="SYS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../logs/sys/mx-saas-platform.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>../logs/sys/mx-saas-platform.%d{yyyyMMdd}.%i.log.gz</fileNamePattern>
            <!-- 保留90天的历史记录-->
            <maxHistory>90</maxHistory>
            <maxFileSize>1GB</maxFileSize>
            <totalSizeCap>100GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <charset>utf-8</charset>
            <pattern>%date [%thread] [traceId-%X{traceId}]%X{apiKey} %-5level %logger{80} - [%M:%L]: %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="SYS_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <discardingThreshold>0</discardingThreshold>
        <queueSize>1024</queueSize>
        <appender-ref ref="SYS_FILE"/>
    </appender>


    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SYS_ASYNC"/>
    </root>
</configuration>